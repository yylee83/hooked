# Add these in Vercel → Settings → Environment Variables, with your real values.
# Never put real keys in this file.

# Podcast Index (podcast data)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Supabase (profiles, login, saved logs and briefs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Weekly email (optional). Server-only: never add NEXT_PUBLIC_ to these.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
DIGEST_FROM=
# Notification emails (follows, replies, sends): RESEND_API_KEY is enough. Optional sender; default
# "Hooked on Pods <hello@hookedonpods.com>". Off the live site, emails go only to EMAIL_TEST_TO.
EMAIL_FROM=
EMAIL_TEST_TO=
CRON_SECRET=
